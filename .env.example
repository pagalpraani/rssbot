# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token

# Your public Render URL (used to register the Telegram webhook)
WEBHOOK_URL=https://your-service-name.onrender.com

# MongoDB Configuration
MONGO_URI=your_mongodb_uri
DB_NAME=RSSFeedBot

# Bot Owner Configuration
OWNER_ID=your_telegram_user_id

# Logging Configuration
LOG_LEVEL=INFO

# Data Retention Policy (in days)
RETENTION_DAYS=90

# Metrics Configuration
METRICS_ENABLED=true

# Auto-Deletion Delays (in seconds)
COMMAND_DELETE_DELAY=60
BOT_PROMPT_DELETE_DELAY=600

# RSS Media Relay — set this to your own deployed Cloudflare Worker before
# production use. Defaults to a third party's personal worker otherwise.
RSS_RELAY_BASE=https://media-relay.gurjar56.workers.dev
