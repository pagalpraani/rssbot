# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token

# Your public Render URL (used to register the Telegram webhook)
WEBHOOK_URL=https://your-service-name.onrender.com

# MongoDB Configuration
MONGO_URI=your_mongodb_uri
DB_NAME=RSSFeedBot

# Bot Owner Configuration
OWNER_ID=your_telegram_user_id

# Logging Configuration
LOG_LEVEL=INFO
# Optional: a Telegram channel ID the bot posts warnings/errors to (chat add/remove,
# RSS failures, watermark failures, unexpected exceptions). Leave unset to disable.
DEV_LOG_CHANNEL=

# RSS Feed Item Cache
RSS_PROCESSED_CACHE_CAP=1000
RSS_MAX_NEW_ITEMS_PER_CYCLE=30

# RSS Media Relay
RSS_RELAY_BASE=https://media-relay.gurjar56.workers.dev
